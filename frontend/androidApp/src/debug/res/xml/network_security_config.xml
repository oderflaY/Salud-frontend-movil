<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para builds de depuracion (vive en src/debug, no en src/main): permite
  HTTP sin cifrar unicamente hacia el backend de desarrollo, nunca hacia
  cualquier otro host. Un build de release NO incluye este archivo, asi que en
  produccion Android exige HTTPS igual que siempre.

  10.0.2.2 es como el emulador de Android ve el "localhost" de la maquina
  anfitriona (ver ConfiguracionApi.BASE_URL). Si pruebas contra un backend en
  la red local desde un telefono fisico, agrega aqui la IP de esa maquina
  (por ejemplo "192.168.1.50") en vez de cambiar este archivo por uno que
  permita cualquier host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.206.42.87</domain>
    </domain-config>
</network-security-config>
