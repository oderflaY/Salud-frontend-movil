<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo depuracion (vive en src/debug; el build de release NO lo incluye y exige
  HTTPS): permite HTTP sin cifrar hacia el backend de desarrollo.

  Ese backend corre en una computadora de la red local cuya IP reasigna el
  router, y la app la busca sola en la subred (VigiaDeServidor). Fijar aqui una
  IP concreta hacia que Android bloqueara el trafico en cuanto cambiaba.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
