<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Escaner de emergencia: lee la tarjeta RFID del paciente. -->
    <uses-permission android:name="android.permission.NFC" />
    <!--
      No obligatoria: el resto de la app (registro de pacientes, historial,
      adherencia) funciona sin NFC. Solo el modulo de emergencia lo necesita.
    -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Recordatorios de medicacion y avisos del medico (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Alarma exacta: una toma de las 08:00 tiene que sonar a las 08:00, no
      "en algun momento de la manana" cuando al sistema le venga bien agrupar
      trabajos. Sin este permiso la app degrada a alarma inexacta en vez de
      dejar al paciente sin aviso, pero pierde precision.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Reprogramar los recordatorios tras un reinicio del telefono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibracion del aviso de medicacion. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Escaner de documentos del chat (adjuntar una receta o un resultado de
      laboratorio en papel). No obligatoria: adjuntar una foto de galeria o un
      archivo ya guardado sigue funcionando sin camara.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salud">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Recibe la alarma y publica el recordatorio. Va declarado en el
          manifiesto y no registrado en codigo porque el sistema tiene que poder
          instanciarlo con la app cerrada, que es justo el caso para el que
          existe. `exported=false`: solo lo dispara nuestra propia alarma.
        -->
        <receiver
            android:name="com.eter.salud.domain.avisos.ReceptorDeRecordatorios"
            android:exported="false" />
    </application>

</manifest>