<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Todo el backend. Antes no se declaraba: llegaba de rebote desde
      transport-backend-cct, una dependencia interna de ML Kit. Quitar ML Kit
      habria dejado la app publicada sin red.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Escaner de emergencia: lee la tarjeta RFID del paciente. -->
    <uses-permission android:name="android.permission.NFC" />
    <!--
      No obligatoria: el resto de la app (registro de pacientes, historial,
      adherencia) funciona sin NFC. Solo el modulo de emergencia lo necesita.
    -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Recordatorios de medicacion y avisos del medico (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Alarma exacta: una toma de las 08:00 tiene que sonar a las 08:00, no
      "en algun momento de la manana" cuando al sistema le venga bien agrupar
      trabajos. Sin este permiso la app degrada a alarma inexacta en vez de
      dejar al paciente sin aviso, pero pierde precision.

      Solo SCHEDULE_EXACT_ALARM, que concede el usuario desde Ajustes (la app
      se lo pide desde la pantalla de medicacion). USE_EXACT_ALARM se quito a
      proposito: Play lo reserva a apps de alarma o calendario y exige
      justificarlo.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Sin RECEIVE_BOOT_COMPLETED: todavia no hay un receptor que vuelva a
      programar las alarmas tras reiniciar el telefono, y declarar un permiso
      que la app no usa obliga a justificarlo en Play. Hasta que exista, las
      tomas pendientes del dia se reprograman cuando el paciente vuelve a abrir
      la pantalla de inicio (HomeScreen.ProgramarRecordatorios).
    -->

    <!-- Vibracion del aviso de medicacion. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Dictado por voz (diario y chat): el permiso se pide al tocar el microfono,
      no al abrir la app.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      El escaner de documentos del chat NO necesita permiso de camara: la API
      de ML Kit (play-services-mlkit-document-scanner) presenta su propia
      interfaz de captura dentro de Play Services y devuelve la pagina ya
      recortada. Declarar CAMERA aqui pedia al usuario un permiso que la app
      nunca usa, y obligaba a justificarlo en la ficha de Play.
      La galeria usa PickVisualMedia, que tampoco requiere permiso.
    -->

    <!--
      allowBackup apagado a proposito: la base local guarda datos clinicos
      (alergias, diagnosticos, medicacion). Con el respaldo automatico esa copia
      sale del telefono hacia Google Drive, fuera del control del expediente.
      El respaldo real del expediente es el backend. allowBackup cubre hasta
      Android 11; en 12+ manda dataExtractionRules, que ademas cierra la
      transferencia directa a otro telefono. Lint pide ademas fullBackupContent
      para Android 7-11, pero ese atributo solo elige QUE respaldar cuando el
      respaldo esta activo; con allowBackup="false" no hay nada que elegir.
    -->
    <!-- Sin esto, Android 11+ oculta el servicio de reconocimiento de voz y el microfono no aparece. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_extraccion_datos"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salud">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Recibe la alarma y publica el recordatorio. Va declarado en el
          manifiesto y no registrado en codigo porque el sistema tiene que poder
          instanciarlo con la app cerrada, que es justo el caso para el que
          existe. `exported=false`: solo lo dispara nuestra propia alarma.
        -->
        <receiver
            android:name="com.eter.salud.domain.avisos.ReceptorDeRecordatorios"
            android:exported="false" />

        <!--
          Abre un adjunto del chat (la receta, el estudio escaneado) con el visor
          del sistema sin copiarlo a una carpeta publica: el visor recibe una URI
          con permiso de lectura solo para esa apertura. La autoridad la usa
          AbridorDeAdjuntos.android.kt.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.adjuntos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_adjuntos" />
        </provider>
    </application>

</manifest>