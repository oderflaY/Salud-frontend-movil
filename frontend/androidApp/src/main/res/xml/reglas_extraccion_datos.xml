<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ no se rige por allowBackup para todo: ese atributo solo apaga el
  respaldo en la nube, y la transferencia directa a un telefono nuevo seguiria
  copiando la base local con alergias, diagnosticos y medicacion. Aqui se
  excluye todo en ambos caminos. El expediente se recupera desde el backend
  al iniciar sesion en el telefono nuevo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
