# Copiar como .env en la raíz de Salud-Frontend y reiniciar `npm run dev`.

# Backend en esta misma computadora (el valor que ya trae el dashboard):
VITE_API_URL=http://localhost:8081/api/v1

# Backend en otra computadora de la red (la del Docker):
# VITE_API_URL=http://192.168.18.26:8081/api/v1

# Producción:
# VITE_API_URL=https://api.tudominio.com/api/v1
