:8000 {
	# Lo que necesita secretos de firma, hashing, estado en memoria (WS) o
	# rate limiting vive en el servicio Rust/Axum.
	@axum path /healthz /auth/* /realtime /tarjetas/* /chat/*
	handle @axum {
		reverse_proxy backend:8080
	}

	# Todo lo demás es CRUD/RPC directo contra PostgREST.
	handle {
		reverse_proxy postgrest:3000
	}
}
