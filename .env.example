# Copiar a .env (nunca versionar .env real) y ajustar valores antes de `docker compose up`.

# --- Postgres ---
POSTGRES_DB=salud
POSTGRES_USER=salud_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# Cadena de conexión usada por el contenedor `migrate` y por `backend` (sqlx).
DATABASE_URL=postgres://salud_admin:change-me-strong-password@db:5432/salud

# Minutos que dura una reserva temporal de franja antes de expirar.
# Se aplica vía GUC de Postgres (ALTER DATABASE ... SET app.minutos_retencion),
# nunca hardcodeado en el backend ni en el cliente.
APP_MINUTOS_RETENCION=5

# --- JWT (compartido entre `backend` y `postgrest`) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRACION_HORAS=12

# --- PostgREST ---
# AUTHENTICATOR_PASSWORD la fija scripts/set_secrets.sh en el rol de Postgres;
# PGRST_DB_URI debe usar la misma contraseña.
AUTHENTICATOR_PASSWORD=change-me-authenticator-password
PGRST_DB_URI=postgres://authenticator:change-me-authenticator-password@db:5432/salud
PGRST_DB_SCHEMAS=api
PGRST_DB_ANON_ROLE=anon
POSTGREST_PORT=3001

# --- Backend (Axum) ---
BACKEND_PORT=8080
RUST_LOG=info,backend=debug
ARGON2_SECRET_KEY=change-me-pepper-for-password-hashing

# --- IA (DeepSeek) — resumen de chat y traducción, módulo opcional ---
# Dejar DEEPSEEK_API_KEY vacía deshabilita el módulo (responde
# IA_NO_CONFIGURADA / 503) sin afectar al resto del backend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELO=deepseek-chat

# --- Proxy (Caddy) ---
PROXY_PORT=8000
