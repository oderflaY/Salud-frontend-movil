-- ============================================================================
-- Cuentas locales de acceso: pacientes y personal medico.
--
-- Mientras no exista el backend en Go, el telefono ES el servidor de cuentas.
-- Por eso la contrasena nunca se guarda: solo su huella PBKDF2-HMAC-SHA256
-- con sal propia (formato `pbkdf2-sha256$iteraciones$sal$huella`, en hex).
--
-- Cerrar sesion NO toca estas tablas: salir de la cuenta borra la sesion de
-- DataStore, no a la persona.
-- ============================================================================

CREATE TABLE cuenta_paciente (
    correo TEXT NOT NULL PRIMARY KEY,
    id_paciente TEXT NOT NULL UNIQUE,
    huella_contrasena TEXT NOT NULL,
    -- 1 mientras el paciente no haya terminado su expediente medico.
    requiere_onboarding INTEGER NOT NULL DEFAULT 1 CHECK (requiere_onboarding IN (0, 1)),
    -- Instante ISO 8601 UTC del alta.
    creada_en TEXT NOT NULL
);

CREATE TABLE cuenta_profesional (
    correo TEXT NOT NULL PRIMARY KEY,
    id_medico TEXT NOT NULL UNIQUE,
    huella_contrasena TEXT NOT NULL,
    nombre TEXT NOT NULL,
    apellidos TEXT NOT NULL,
    tratamiento TEXT NOT NULL,
    cedula_profesional TEXT NOT NULL UNIQUE,
    -- EstadoVerificacionCedula.name
    estado_verificacion TEXT NOT NULL
);

pacientePorCorreo:
SELECT *
FROM cuenta_paciente
WHERE correo = ?;

insertarPaciente:
INSERT INTO cuenta_paciente(correo, id_paciente, huella_contrasena, requiere_onboarding, creada_en)
VALUES (?, ?, ?, ?, ?);

-- Siembra idempotente de las cuentas de demostracion.
insertarPacienteSiNoExiste:
INSERT OR IGNORE INTO cuenta_paciente(correo, id_paciente, huella_contrasena, requiere_onboarding, creada_en)
VALUES (?, ?, ?, ?, ?);

marcarOnboardingCompleto:
UPDATE cuenta_paciente
SET requiere_onboarding = 0
WHERE id_paciente = ?;

profesionalPorCorreo:
SELECT *
FROM cuenta_profesional
WHERE correo = ?;

contarCedula:
SELECT count(*)
FROM cuenta_profesional
WHERE cedula_profesional = ?;

insertarProfesional:
INSERT INTO cuenta_profesional(
    correo, id_medico, huella_contrasena, nombre, apellidos, tratamiento,
    cedula_profesional, estado_verificacion
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertarProfesionalSiNoExiste:
INSERT OR IGNORE INTO cuenta_profesional(
    correo, id_medico, huella_contrasena, nombre, apellidos, tratamiento,
    cedula_profesional, estado_verificacion
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);
